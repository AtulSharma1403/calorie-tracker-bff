{
  "openapi": "3.0.0",
  "info": {
    "title": "Calorie Tracker API",
    "description": "API for tracking calories, activities, and foods",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Get all users",
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "A list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Create a new user",
        "tags": [
          "Users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "summary": "Get user by ID",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/activities": {
      "get": {
        "summary": "Get all activities",
        "tags": [
          "Activities"
        ],
        "responses": {
          "200": {
            "description": "A list of activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Create a new activity",
        "tags": [
          "Activities"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Activity created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/activities/summary": {
      "get": {
        "summary": "Get user activity summary for all days",
        "tags": [
          "Activities"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User activity summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "format": "date"
                          },
                          "totalCalories": {
                            "type": "number"
                          },
                          "totalDuration": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/activities/useractivity": {
      "get": {
        "summary": "Get user activities",
        "tags": [
          "Activities"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Activity date (optional)"
          }
        ],
        "responses": {
          "200": {
            "description": "User activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserActivity"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Add user activity",
        "tags": [
          "Activities"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserActivityInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Activity added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserActivity"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/activities/{activityName}": {
      "get": {
        "summary": "Get specific motions by activity name",
        "tags": [
          "Activities"
        ],
        "parameters": [
          {
            "name": "activityName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Activity name"
          }
        ],
        "responses": {
          "200": {
            "description": "List of specific motions for the activity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Activity not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/foods/groups": {
      "get": {
        "summary": "Get all food groups",
        "tags": [
          "Foods"
        ],
        "responses": {
          "200": {
            "description": "A list of food groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/foods/group/{foodGroup}": {
      "get": {
        "summary": "Get foods by group",
        "tags": [
          "Foods"
        ],
        "parameters": [
          {
            "name": "foodGroup",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Food group name"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of foods in the specified group",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Food"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Food group not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/foods/userfood": {
      "get": {
        "summary": "Get user food",
        "tags": [
          "Foods"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of user foods",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserFood"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Add user food",
        "tags": [
          "Foods"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserFoodInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User food added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserFood"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Food not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/csv/import-food": {
      "post": {
        "summary": "Import food data from CSV file",
        "tags": [
          "CSV Import"
        ],
        "responses": {
          "200": {
            "description": "Food data imported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Import failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/csv/import-activity": {
      "post": {
        "summary": "Import activity data from CSV file",
        "tags": [
          "CSV Import"
        ],
        "responses": {
          "200": {
            "description": "Activity data imported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Import failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "other"
            ]
          },
          "age": {
            "type": "number"
          },
          "bmr": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserInput": {
        "type": "object",
        "required": [
          "name",
          "weight",
          "height",
          "gender",
          "age"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "other"
            ]
          },
          "age": {
            "type": "number"
          },
          "bmr": {
            "type": "number"
          }
        }
      },
      "Activity": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "ACTIVITY": {
            "type": "string"
          },
          "SPECIFIC_MOTION": {
            "type": "string"
          },
          "METs": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActivityInput": {
        "type": "object",
        "required": [
          "ACTIVITY",
          "SPECIFIC_MOTION",
          "METs"
        ],
        "properties": {
          "ACTIVITY": {
            "type": "string"
          },
          "SPECIFIC_MOTION": {
            "type": "string"
          },
          "METs": {
            "type": "number"
          }
        }
      },
      "UserActivity": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "activityName": {
            "type": "string"
          },
          "activityDescription": {
            "type": "string"
          },
          "metValue": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          },
          "calorie": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserActivityInput": {
        "type": "object",
        "required": [
          "userId",
          "activityName",
          "metValue",
          "duration",
          "date"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "activityName": {
            "type": "string"
          },
          "activityDescription": {
            "type": "string"
          },
          "metValue": {
            "type": "number"
          },
          "duration": {
            "type": "number",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Food": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "calories": {
            "type": "number"
          },
          "protein": {
            "type": "number"
          },
          "carbs": {
            "type": "number"
          },
          "fat": {
            "type": "number"
          },
          "servingSize": {
            "type": "string"
          },
          "foodGroup": {
            "type": "string"
          },
          "foodId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserFood": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "foodName": {
            "type": "string"
          },
          "mealType": {
            "type": "string"
          },
          "foodGroup": {
            "type": "string"
          },
          "serving": {
            "type": "string"
          },
          "calorie": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserFoodInput": {
        "type": "object",
        "required": [
          "userId",
          "foodName",
          "mealType",
          "foodGroup",
          "serving",
          "date"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "foodName": {
            "type": "string"
          },
          "mealType": {
            "type": "string"
          },
          "foodGroup": {
            "type": "string"
          },
          "serving": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}